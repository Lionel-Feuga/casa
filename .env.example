# Copie ce fichier en .env.local et remplis les valeurs (ne jamais le committer).
MONGODB_URI=
MONGODB_DB=casa
# Empreinte bcrypt du code à 6 chiffres : npm run hash-code -- 123456
ACCESS_CODE_HASH=
# Clé serveur Ably (facultative tant que le compte n'existe pas : l'appli recharge alors toutes les 15 s)
ABLY_API_KEY=
